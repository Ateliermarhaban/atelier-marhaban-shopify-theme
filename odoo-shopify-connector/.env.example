# ---------------------------------------------------------------------------
# Odoo Online (SaaS) — externe API (XML-RPC)
# ---------------------------------------------------------------------------
ODOO_URL=https://ateliermarhaban.odoo.com
ODOO_DB=ateliermarhaban
# Gebruik een dedicated integratie-gebruiker met rechten op Voorraad.
ODOO_USERNAME=connector@atelier-marhaban.com
# Maak een API-key aan in Odoo: Profiel > Account Security > API-sleutels.
ODOO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Naam van de Odoo-magazijnlocatie waarvan de voorraad gesynct wordt.
# Leeg = alle interne locaties samengeteld.
ODOO_LOCATION_NAME=WH/Stock

# ---------------------------------------------------------------------------
# Shopify — Admin API (custom app)
# ---------------------------------------------------------------------------
SHOPIFY_SHOP=atelier-marhaban.myshopify.com
# Admin API access token van je custom app (shpat_...).
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2025-01
# De Shopify location-id waar voorraad op geboekt wordt (numeriek).
# Vind je via scripts/test-connection.js of Shopify admin > Instellingen > Locaties.
SHOPIFY_LOCATION_ID=
# Geheim om webhook-HMAC te verifiëren (zie scripts/register-webhooks.js output).
SHOPIFY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
PORT=3000
# Publieke basis-URL van deze service (voor webhook-registratie).
PUBLIC_URL=https://jouw-connector.example.com
# Poll-interval voor Odoo -> Shopify in seconden.
POLL_INTERVAL_SECONDS=120
# Zet op 'true' om wijzigingen alleen te loggen, niets weg te schrijven.
DRY_RUN=false
