<section class="hero hero--homepage" style="background: linear-gradient(135deg, #f5f1e8 0%, #fff 100%); padding: 80px 20px; text-align: center;">
  <div class="container">
    <h1 style="font-family: 'Cormorant', serif; font-weight: 300; font-size: 56px; color: #5e7361; margin: 0 0 20px 0; line-height: 1.2;">
      Niet ontworpen, gevonden.
    </h1>
    
    <p style="font-family: 'Nunito Sans', sans-serif; font-size: 18px; color: #ba6a55; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; margin: 0 0 40px 0;">
      Westerse kwaliteit, Marokkaanse hand
    </p>
    
    <p style="font-family: 'Nunito Sans', sans-serif; font-size: 16px; color: #2e2e2e; max-width: 600px; margin: 0 auto 50px auto; line-height: 1.6;">
      Atelier Marhaban brengt authentieke ambachtskwaliteit uit Marokko naar jouw interieur. We filteren. We zeggen nee tegen wat niet goed genoeg is. Dat betekent: je voelt waar het vandaan komt, en je weet dat het hier thuis hoort.
    </p>
    
    <a href="/collections" class="btn btn--primary" style="display: inline-block; background: #5e7361; color: #fff; padding: 14px 32px; text-decoration: none; font-family: 'Nunito Sans', sans-serif; font-size: 14px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; border-radius: 2px;">
      Bekijk selectie
    </a>
  </div>
  
  <!-- PLACEHOLDER: Hero image -->
  <div class="hero__image" style="margin-top: 60px;">
    <img src="[REPLACE: cdn/shop/files/homepage-hero.jpg]" alt="Handgemaakte zelliges en keramiek uit Marokko" style="width: 100%; max-width: 1000px; display: block; margin: 0 auto;">
  </div>
</section>

<!-- ========================================
SECTIE 2: DE BRUG (Three-column)
======================================== -->

<section class="the-bridge" style="background: #fff; padding: 80px 20px;">
  <div class="container">
    <h2 style="font-family: 'Cormorant', serif; font-weight: 400; font-size: 36px; color: #5e7361; text-align: center; margin: 0 0 60px 0;">
      De brug
    </h2>
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px;">
      
      <!-- Kolom 1: Architect/Particulier -->
      <div class="bridge-column">
        <h3 style="font-family: 'Nunito Sans', sans-serif; font-weight: 600; font-size: 14px; color: #ba6a55; text-transform: uppercase; letter-spacing: 0.1em; margin: 0 0 16px 0;">
          Veeleisende klant
        </h3>
        <p style="font-family: 'Nunito Sans', sans-serif; font-size: 15px; color: #2e2e2e; line-height: 1.6; margin: 0;">
          Je bent architect, ontwerper, of particulier. Je bent verliefd op Marokko, maar je bent voorzichtig. Je wil niet zomaars hopen dat het werkt. Je wil betrouwbaarheid. Schaal. Afwerking.
        </p>
      </div>
      
      <!-- Kolom 2: Atelier Marhaban -->
      <div class="bridge-column" style="background: #5e7361; padding: 40px; border-radius: 2px;">
        <h3 style="font-family: 'Nunito Sans', sans-serif; font-weight: 600; font-size: 14px; color: #dec8b8; text-transform: uppercase; letter-spacing: 0.1em; margin: 0 0 16px 0;">
          Atelier Marhaban
        </h3>
        <p style="font-family: 'Nunito Sans', sans-serif; font-size: 15px; color: #dec8b8; line-height: 1.6; margin: 0;">
          We spreken beide talen. We begrijpen wat jij nodig hebt. En we kennen wat Mohamed kan geven. We zeggen nee tegen wat niet schaalrecht is. Ja tegen wat past.
        </p>
      </div>
      
      <!-- Kolom 3: Ambachtsman -->
      <div class="bridge-column">
        <h3 style="font-family: 'Nunito Sans', sans-serif; font-weight: 600; font-size: 14px; color: #ba6a55; text-transform: uppercase; letter-spacing: 0.1em; margin: 0 0 16px 0;">
          Nonchalante ambachtsman
        </h3>
        <p style="font-family: 'Nunito Sans', sans-serif; font-size: 15px; color: #2e2e2e; line-height: 1.6; margin: 0;">
          Mohamed in Marokko. Hij maakt potten op intuïtie. Waarom zou de schaal exact gelijk zijn? Dat interesseert hem niet. Maar het interesseert ons wel.
        </p>
      </div>
    </div>
  </div>
</section>

