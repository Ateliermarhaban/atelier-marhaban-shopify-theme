nsform:uppercase; opacity:0.8; }\n  #am-variant-specs-{{ section.id }} .am-spec__value { display:block; font-size:1.1rem; font-weight:600; }\n  @media (min-width: 768px) { .media-gallery__inner { max-width: max(340px, calc(100vh - 320px)); margin-inline: auto; } }\n  @media (max-width: 767px) { #am-variant-specs-{{ section.id }} { grid-template-columns:repeat(2,1fr); } }\n</style>\n<script type=\"application/json\" id=\"am-variant-specs-data-{{ section.id }}\">\n{\n  {%- for v in product.variants -%}\n    \"{{ v.id }}\": {\n      \"diameter\": {{ v.metafields.custom.diameter | json }},\n      \"hoogte\": {{ v.metafields.custom.hoogte | json }},\n      \"brandtijd\": {{ v.metafields.custom.brandtijd | json }},\n      \"gewicht\": {{ v.metafields.custom.gewicht | json }}\n    }{% unless forloop.last %},{% endunless %}\n  {%- endfor -%}\n}\n</script>\n<script>\n(function(){\n  const sectionId = \"{{ section.id }}\";\n  const root = document.getElementById(\"am-variant-specs-\" + sectionId);\n  const dataEl = document.getElementById(\"am-variant-specs-data-\" + sectionId);\n  if (!root || !dataEl) return;\n  const data = JSON.parse(dataEl.textContent);\n  function fmt(key, val){\n    let v = (val ?? \"\").toString().trim();\n    if (!v) return \"–\";\n    v = v.replace(/^(\\d+(?:[.,]\\d+)?)\\s*([a-zA-Z]+)$/, \"$1 $2\");\n    if (key === \"brandtijd\") v = v.replace(/\\s*h$/i, \" uur\");\n    if (key === \"gewicht\") { const m = v.match(/^(\\d+)\\s*g$/i); if (m && +m[1] >= 1000) v = (m[1]/1000).toFixed(1).replace(\".\", \",\") + \" kg\"; }\n    return v;\n  }\n  function getCurrentVariantId(){\n    const form = root.closest('form');\n    const idInput = form ? form.querySelector('input[name=\"id\"]') : document.querySelector('input[name=\"id\"]');\n    return idInput ? idInput.value : null;\n  }\n  function render(variantId){\n    const d = data[String(variantId)];\n    if (!d) return;\n    root.querySelectorAll('[data-k]').forEach(el => { const k = el.getAttribute('data