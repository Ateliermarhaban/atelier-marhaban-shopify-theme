{%- comment -%}
  Parameters:
  - product {Object} - Product object.

  Eigen productgegevens voor Google (vervangt product | structured_data):
  elke variant krijgt een beschrijving en verzendgegevens per land,
  zoals Search Console vraagt voor verkopersvermeldingen.
  Verzendtarieven volgen de Shopify-verzendprofielen (11/11/2026):
  - zelliges, bejmats, kubussen: pallet, BE € 75, NL/FR/LU € 110 (tot 60 kg)
  - stalen: verzending inbegrepen
  - rest: BE € 9,95 (gratis vanaf € 150), NL/FR/LU € 14,95 (gratis vanaf € 250)
  Geen gtin: de barcodes zijn interne EAN-13 (2001...), geen geldige GTIN.
  Retourbeleid nog niet opgenomen: wacht op beslissing (projecthandleiding).

  Usage:
  {% render 'structured-data-product', product: product %}
{%- endcomment -%}

{%- liquid
  assign am_type = product.type | downcase
  assign am_kind = 'pakje'
  if am_type contains 'zellige' or am_type contains 'bejmat'
    assign am_kind = 'pallet'
  elsif am_type == 'staal'
    assign am_kind = 'staal'
  endif

  assign am_desc = product.description | strip_html | strip_newlines | strip
  if am_desc == blank
    assign am_desc = product.metafields.global.description_tag | default: product.title
  endif
  assign am_desc = am_desc | truncate: 4900

  assign am_brand = product.vendor | default: shop.name
  assign am_url = request.origin | append: product.url
  assign am_countries = 'BE,NL,FR,LU' | split: ','
-%}

{%- capture am_offer_extra -%}
  "shippingDetails": [
    {%- for country in am_countries -%}
      {%- liquid
        if am_kind == 'pallet'
          if country == 'BE'
            assign am_rate = '75.00'
          else
            assign am_rate = '110.00'
          endif
          assign am_handling_max = 10
          assign am_transit_max = 5
        elsif am_kind == 'staal'
          assign am_rate = '0.00'
          assign am_handling_max = 5
          assign am_transit_max = 3
        else
          if country == 'BE'
            assign am_rate = '9.95'
            assign am_free = 15000
          else
            assign am_rate = '14.95'
            assign am_free = 25000
          endif
          assign am_handling_max = 5
          assign am_transit_max = 3
        endif
      -%}
      {
        "@type": "OfferShippingDetails",
        "shippingRate": { "@type": "MonetaryAmount", "value": "__RATE__", "currency": {{ cart.currency.iso_code | json }} },
        "shippingDestination": { "@type": "DefinedRegion", "addressCountry": {{ country | json }} },
        "deliveryTime": {
          "@type": "ShippingDeliveryTime",
          "handlingTime": { "@type": "QuantitativeValue", "minValue": 1, "maxValue": {{ am_handling_max }}, "unitCode": "DAY" },
          "transitTime": { "@type": "QuantitativeValue", "minValue": 1, "maxValue": {{ am_transit_max }}, "unitCode": "DAY" }
        }
      }__SEP_{{ country }}__
    {%- endfor -%}
  ]
{%- endcapture -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  {%- if product.has_only_default_variant %}
  "@type": "Product",
  {%- else %}
  "@type": "ProductGroup",
  "productGroupID": {{ product.id | json }},
  {%- endif %}
  "@id": {{ am_url | append: '#product' | json }},
  "name": {{ product.title | json }},
  "description": {{ am_desc | json }},
  "url": {{ am_url | json }},
  "brand": { "@type": "Brand", "name": {{ am_brand | json }} },
  {%- if product.type != blank %}
  "category": {{ product.type | json }},
  {%- endif %}
  {%- if product.featured_media %}
  "image": {{ product.featured_media | image_url: width: 1600 | prepend: 'https:' | json }},
  {%- endif %}
  {%- unless product.has_only_default_variant %}
  "variesBy": [
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign oname = option.name | downcase
        if oname contains 'kleur' or oname contains 'color' or oname contains 'colour'
          assign oprop = 'https://schema.org/color'
        elsif oname contains 'formaat' or oname contains 'maat' or oname contains 'size'
          assign oprop = 'https://schema.org/size'
        elsif oname contains 'materiaal' or oname contains 'afwerking'
          assign oprop = 'https://schema.org/material'
        else
          assign oprop = 'https://schema.org/pattern'
        endif
      -%}
      {{ oprop | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  "hasVariant": [
  {%- endunless %}
  {%- for variant in product.variants -%}
    {%- liquid
      assign v_url = am_url | append: '?variant=' | append: variant.id
      assign v_media = variant.featured_media | default: product.featured_media
      if variant.available
        assign v_avail = 'https://schema.org/InStock'
        if variant.inventory_management != blank and variant.inventory_quantity <= 0
          assign v_avail = 'https://schema.org/BackOrder'
        endif
      else
        assign v_avail = 'https://schema.org/OutOfStock'
      endif
      assign v_price = variant.price | divided_by: 100.0 | round: 2
      assign v_extra = am_offer_extra
      for country in am_countries
        assign sep = '__SEP_' | append: country | append: '__'
        if forloop.last
          assign v_extra = v_extra | replace: sep, ''
        else
          assign v_extra = v_extra | replace: sep, ','
        endif
      endfor
      if am_kind == 'pakje'
        assign v_extra = v_extra | replace_first: '"__RATE__"', '"RATE_BE"' | replace: '"__RATE__"', '"RATE_X"'
        if variant.price >= 15000
          assign v_extra = v_extra | replace: '"RATE_BE"', '"0.00"'
        else
          assign v_extra = v_extra | replace: '"RATE_BE"', '"9.95"'
        endif
        if variant.price >= 25000
          assign v_extra = v_extra | replace: '"RATE_X"', '"0.00"'
        else
          assign v_extra = v_extra | replace: '"RATE_X"', '"14.95"'
        endif
      elsif am_kind == 'pallet'
        assign v_extra = v_extra | replace_first: '"__RATE__"', '"75.00"' | replace: '"__RATE__"', '"110.00"'
      else
        assign v_extra = v_extra | replace: '"__RATE__"', '"0.00"'
      endif
    -%}
    {%- unless product.has_only_default_variant %}
    {
      "@type": "Product",
      "@id": {{ v_url | append: '#variant' | json }},
      "name": {{ product.title | append: ' - ' | append: variant.title | json }},
      "description": {{ am_desc | json }},
      "url": {{ v_url | json }},
      "brand": { "@type": "Brand", "name": {{ am_brand | json }} },
      {%- if v_media %}
      "image": {{ v_media | image_url: width: 1600 | prepend: 'https:' | json }},
      {%- endif %}
      {%- if variant.sku != blank %}
      "sku": {{ variant.sku | json }},
      "mpn": {{ variant.sku | json }},
      {%- endif %}
      {%- for option in variant.options -%}
        {%- assign oname = product.options[forloop.index0] | downcase -%}
        {%- if oname contains 'kleur' or oname contains 'color' -%}
      "color": {{ option | json }},
        {%- elsif oname contains 'formaat' or oname contains 'maat' or oname contains 'size' -%}
      "size": {{ option | json }},
        {%- endif -%}
      {%- endfor %}
    {%- else %}
  {%- if variant.sku != blank %}
  "sku": {{ variant.sku | json }},
  "mpn": {{ variant.sku | json }},
  {%- endif %}
    {%- endunless %}
      "offers": {
        "@type": "Offer",
        "url": {{ v_url | json }},
        "price": {{ v_price | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "availability": {{ v_avail | json }},
        "itemCondition": "https://schema.org/NewCondition",
        "seller": { "@type": "Organization", "name": {{ shop.name | json }} },
        {{ v_extra }}
      }
    {%- unless product.has_only_default_variant %}
    }{% unless forloop.last %},{% endunless %}
    {%- endunless %}
    {%- if product.has_only_default_variant %}{% break %}{% endif %}
  {%- endfor %}
  {%- unless product.has_only_default_variant %}
  ]
  {%- endunless %}
}
</script>
